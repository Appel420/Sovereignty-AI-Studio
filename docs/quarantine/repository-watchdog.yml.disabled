# Retired from .github/workflows because its registered workflow repeatedly returned startup_failure with zero jobs.
# Preserved verbatim from Collaboration for audit/recovery.
name: Repository Watchdog

on:
  workflow_dispatch: active
  pull_request:
    branches: [Collaboration]

permissions:
  contents: read

concurrency:
  group: repository-watchdog-${{ github.ref }}
  cancel-in-progress: true

jobs:
  watch:
    name: Repository Watchdog (visible)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Watchdog startup — visible
        run: |
          set -Eeuo pipefail
          printf 'WATCHDOG_STATUS=STARTED\n'
          printf 'WATCHDOG_EVENT=%s\n' "${GITHUB_EVENT_NAME}"
          printf 'WATCHDOG_HEAD_SHA=%s\n' "${GITHUB_SHA}"
      - name: Checkout exact revision
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 1
          persist-credentials: false
      - name: Verify active workflow boundary
        shell: bash
        run: |
          set -Eeuo pipefail
          test -d .github/workflows
          test ! -e .github/workflows/main_CI.yml
          test -f .github/workflows/ci.yml
          test -f .github/workflows/ci-sovereign.yml
          test -f .github/workflows/python-ci.yml
          test -f .github/workflows/Quart.yml
          test -f .github/workflows/repository-watchdog.yml
          printf 'COLLABORATION_WORKFLOW_BOUNDARY=PASS\n'
      - name: Final watchdog result — visible
        run: |
          set -Eeuo pipefail
          printf 'WATCHDOG_STATUS=PASS\n'
          printf 'WATCHDOG_RESULT=COLLABORATION_WORKFLOW_BOUNDARY_VERIFIED\n'
