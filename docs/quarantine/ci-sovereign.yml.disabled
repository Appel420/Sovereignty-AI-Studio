# Retired from .github/workflows after repeated startup failures on Collaboration.
name: Sovereign Device Validation

on:
  workflow_dispatch:
  pull_request:
    branches: [Collaboration]

permissions:
  contents: read

jobs:
  conformance:
    name: Sovereign Validation (visible)
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout exact revision without external actions
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -Eeuo pipefail
          git init .
          git remote add origin "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}.git"
          auth="$(printf 'x-access-token:%s' "${GH_TOKEN}" | base64 -w0)"
          git -c http.extraheader="AUTHORIZATION: basic ${auth}" fetch --no-tags --depth=1 origin "${GITHUB_SHA}"
          git checkout --detach FETCH_HEAD
          git config --unset-all http.extraheader 2>/dev/null || true
      - name: Runner evidence
        run: |
          set -Eeuo pipefail
          test "${GITHUB_ACTIONS}" = "true"
          echo "RUNNER=${RUNNER_NAME}/${RUNNER_OS}/${RUNNER_ARCH}"
          echo "SHA=${GITHUB_SHA}"
      - name: Python syntax gate
        run: python3 -m compileall -q backend apps scripts tests
      - name: I-008 gate when present
        run: if [[ -f scripts/verify_i008_contract.py ]]; then python3 scripts/verify_i008_contract.py; else echo 'I-008 script not present; gate skipped by repository state.'; fi
      - name: Test suite
        run: python3 -m pytest -q tests
