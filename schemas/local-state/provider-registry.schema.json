{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-state/provider-registry.schema.json",
  "title": "Device-local provider registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "storage_root", "network", "external_memory", "providers", "wake_word"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "storage_root": {"const": "device-local"},
    "network": {"const": "disabled"},
    "external_memory": {"const": "disabled"},
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "storage", "network"],
        "properties": {
          "id": {"type": "string", "pattern": "^local\\.[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "storage": {"type": "string", "minLength": 1},
          "network": {"const": false}
        }
      }
    },
    "wake_word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "recognition", "remote_recognition", "status"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "recognition": {"const": "local_engine_required"},
        "remote_recognition": {"const": false},
        "status": {"const": "not_configured"}
      }
    }
  }
}
