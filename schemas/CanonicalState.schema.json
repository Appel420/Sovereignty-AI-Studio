{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereignty:canonical-state:v1",
  "title": "CanonicalState",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "session", "audit"],
  "properties": {
    "policy": {"$ref": "EffectivePolicy.schema.json"},
    "session": {"$ref": "SessionState.schema.json"},
    "audit": {"type": "array", "items": {"$ref": "AuditEvent.schema.json"}},
    "feature_usage": {"type": "array", "items": {"$ref": "FeatureUsage.schema.json"}}
  }
}
