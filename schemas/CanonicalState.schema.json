{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereignty:canonical-state:v1",
  "title": "CanonicalState",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "session", "audit"],
  "properties": {
    "policy": {"$ref": "urn:sovereignty:effective-policy:v1"},
    "session": {"$ref": "urn:sovereignty:session-state:v1"},
    "audit": {"type": "array", "items": {"$ref": "urn:sovereignty:audit-event:v1"}},
    "feature_usage": {"type": "array", "items": {"$ref": "urn:sovereignty:feature-usage:v1"}}
  }
}
