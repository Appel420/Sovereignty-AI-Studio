{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovereignty:model-discovery-result:v1",
  "title": "ModelDiscoveryResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "discovery_status", "discovery_reason"],
  "properties": {
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/DiscoveredModel"}},
    "discovery_status": {"type": "string", "enum": ["ok", "unknown", "failed"]},
    "discovery_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "DiscoveredModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_b", "multimodal", "source", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size_b": {"type": ["number", "null"], "minimum": 0},
        "multimodal": {"type": "boolean"},
        "source": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    }
  }
}
