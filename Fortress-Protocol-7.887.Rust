Generate a fresh random salt. Compute the password hash using Argon2id(password, salt). Retrieve the environment variable “FORTRESS_SALT”. Derive the key using Blake3(password_hash || env_salt). Compress the raw data into a compressed format. Seal the compressed data using the derived key to create a ciphertext. Compute the stored_checksum using Blake3(sealed). Write the ciphertext, stored_checksum, and salt to a fortress file.

To open the fortress file, read and parse it to retrieve the ciphertext, stored_checksum, and salt. Compute the password_hash using Argon2id(password, salt). Retrieve the environment variable “FORTRESS_SALT”. Derive the key using Blake3(password_hash || env_salt). Compute the verification_checksum using Blake3(ciphertext). If the verification_checksum doesn’t match the stored_checksum, return an error indicating a checksum mismatch and tampering. Otherwise, open the ciphertext (decrypt it) to retrieve the compressed data. Decompress the compressed data to obtain the plaintext. Return the import os
import blake3
import argon2
import zlib
from cryptography.hazmat.primitives.ciphers.aead import ChaCha20Poly1305

# Generate a key from the checksum of a formatted string containing the password hash and environment salt
def generate_key_from_checksum(password_hash: bytes, env_salt: bytes) -> bytes:
    formatted = f"{password_hash.hex()}::{env_salt.hex()}".encode()
    checksum = blake3.blake3(formatted).digest()
    return checksum

# Seal data into a fortress file
def seal_fortress(password: str, data: bytes, fortress_file: str):
    # Generate a random salt
    salt = os.urandom(16)
    
    # Compute Argon2id hash
    ph = argon2.low_level.hash_secret_raw(
        password.encode(),
        salt,
        time_cost=2,
        memory_cost=102400,
        parallelism=8,
        hash_len=32,
        type=argon2.low_level.Type.ID
    )
    
    env_salt = os.environ.get("FORTRESS_SALT", "").encode()
    
    # Derive key
    key = generate_key_from_checksum(ph, env_salt)

    # Compress data
    compressed = zlib.compress(data)

    # Seal data (encrypt)
    cipher = ChaCha20Poly1305(key[:32])
    nonce = os.urandom(12)
    ciphertext = nonce + cipher.encrypt(nonce, compressed, None)

    # Compute checksum
    stored_checksum = blake3.blake3(ciphertext).digest()

    # Write fortress file
    with open(fortress_file, "wb") as f:
        f.write(len(salt).to_bytes(2, 'big') + salt)
        f.write(len(stored_checksum).to_bytes(2, 'big') + stored_checksum)
        f.write(ciphertext)

def open_fortress(password: str, fortress_file: str) -> bytes:
    with open(fortress_file, "rb") as f:
        salt_len = int.from_bytes(f.read(2), 'big')
        salt = f.read(salt_len)
        checksum_len = int.from_bytes(f.read(2), 'big')
        stored_checksum = f.read(checksum_len)
        ciphertext = f.read()

    ph = argon2.low_level.hash_secret_raw(
        password.encode(),
        salt,
        time_cost=2,
        memory_cost=102400,
        parallelism=8,
        hash_len=32,
        type=argon2.low_level.Type.ID
    )

    env_salt = os.environ.get("FORTRESS_SALT", "").encode()
    key = generate_key_from_checksum(ph, env_salt)

    verification_checksum = blake3.blake3(ciphertext).digest()
    if verification_checksum != stored_checksum:
        raise ValueError("Checksum mismatch detected; data may have been tampered with.")

    # Decrypt ciphertext
    nonce, encrypted = ciphertext[:12], ciphertext[12:]
    cipher = ChaCha20Poly1305(key[:32])
    compressed = cipher.decrypt(nonce, encrypted, None)

    # Decompress and return plaintext
    plaintext = zlib.decompress(compressed)
    return plaintext

Define a function to generate a key from the checksum of a formatted string containing the password hash and the environment salt.
