# Sovereignty AI Studio — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# ═══════════════════════════════════════════════════════
# DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# 9897 — Python bridge.py   (local AI/WS backend)
# 9898 — KODER frontend     (SGHv119.html static file server)
# 9899 — Node.js node-bridge (outgoing backend proxy, WS/API)
# Backend, DB, and Redis are internal-only (Docker network).

# ═══════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════
NODE_BRIDGE_PORT=9899
BACKEND_PORT=9899
WEATHER_PORT=9899
WEB_APP_PORT=9898
FRONTEND_PORT=9898
PORT_UNIFIED=9899
PORT_BRIDGE=9899
PORT_AUTH=9899

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://sovereignty:password@localhost:9899/sovereignty_db
POSTGRES_USER=sovereignty
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=sovereignty_db

# ═══════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:9899/0

# ═══════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════
JWT_SECRET=your-jwt-secret-here-change-in-production
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
KEY_FILE=.sg_master_key

# ═══════════════════════════════════════════════════════
# SOVEREIGN AI CONFIGURATION (no external SaaS)
# ═══════════════════════════════════════════════════════
# Path to your locally-hosted GGUF model file
SOVEREIGN_MODEL_PATH=/models/sovereign.gguf
# Path to your locally-hosted ONNX model file
SOVEREIGN_ONNX_PATH=/models/sovereign.onnx
# URL of your own sovereign API endpoint (self-hosted)
SOVEREIGN_API_URL=http://localhost:9899/api/ai
# Comma-separated provider order (never falls back to external SaaS)
SOVEREIGN_PROVIDER_ORDER=local_gguf,local_onnx,sovereign_api

# ═══════════════════════════════════════════════════════
# SERVICE URLs (inter-service communication)
# ═══════════════════════════════════════════════════════
# Docker internal network
BACKEND_URL=http://backend:9899
WEATHER_URL=http://backend:9899

# Local development overrides (uncomment if needed)
# BACKEND_URL=http://localhost:9899
# WEATHER_URL=http://localhost:9899

# ═══════════════════════════════════════════════════════
# PIPER TTS CONFIGURATION (self-hosted voice)
# ═══════════════════════════════════════════════════════
PIPER_BIN=./piper
PIPER_MODEL=./models/en_US-lessac-medium.onnx
PIPER_DIR=./piper-tts

# ═══════════════════════════════════════════════════════
# KEYCLOAK AUTHENTICATION (self-hosted)
# ═══════════════════════════════════════════════════════
KEYCLOAK_URL=http://localhost:9899
KEYCLOAK_REALM=sovereignty
KEYCLOAK_CLIENT_ID=sovereignty-studio
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ═══════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:9898

# ═══════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION (optional, for production)
# ═══════════════════════════════════════════════════════
# Provide absolute paths to PEM-encoded cert & key to enable HTTPS.
# When set, nginx (port 9899) terminates TLS and node-bridge/unified
# server can also serve HTTPS directly.
# Generate self-signed certs for local dev:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout ./certs/key.pem -out ./certs/cert.pem \
#     -subj "/CN=localhost"
TLS_CERT=
TLS_KEY=

# ═══════════════════════════════════════════════════════
# LOGGING & MONITORING
# ═══════════════════════════════════════════════════════
LOG_DIR=./logs
VERBOSE=0
DEBUG=false
ENVIRONMENT=production

# ═══════════════════════════════════════════════════════
# OPTIONAL FEATURE FLAGS
# ═══════════════════════════════════════════════════════
ALLOW_SHELL=0
SAVE_TRANSFERS=1
RELOAD=0

# ═══════════════════════════════════════════════════════
# PORT ALLOCATION SUMMARY
# ═══════════════════════════════════════════════════════
# EXTERNAL ACCESS (users/clients):
#   9897  — Python bridge.py (local AI/WS backend)
#   9898  — KODER frontend (SGHv119.html static file server)
#   9899  — Node.js node-bridge (outgoing proxy — WS/API)
#
# INTERNAL SERVICES (Docker network only):
#   3000  — Frontend (React)
#   5432  — PostgreSQL
#   6379  — Redis
#   8000  — Backend FastAPI
#   8001  — Weather Dashboard
#   8080  — Web App Server
#   8443  — Auth Proxy
#   9000  — Unified Server
#
# KEY PRINCIPLE: Frontend at 9898; bridge proxy at 9899; Python AI at 9897.

# ═══════════════════════════════════════════════════════
# MULTI-AGENT SYSTEM CONFIGURATION
# ═══════════════════════════════════════════════════════
# Judge Agent
JUDGE_AGENT_PORT=9899
JUDGE_METRICS_PORT=9899

# AI Router Agent
AI_ROUTER_PORT=9899

# Plugin Agent
PLUGIN_AGENT_PORT=9899

# Platform Agent
PLATFORM_AGENT_PORT=9899

# Voice Assist Agent
VOICE_ASSIST_PORT=9899

# Gateway
GATEWAY_PORT=9898

# Python Backend Bridge (bridge.py WebSocket server — port 9897)
# KODER (frontend) connects to node-bridge on 9899; node-bridge proxies AI/TTS/memory messages here.
SG_BRIDGE_URL=ws://localhost:9897
SG_PORT=9897
SG_HOST=localhost

# Prometheus metrics
METRICS_PORT=9899

# Platform connector credentials (streaming platforms)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
YOUTUBE_API_KEY=your-youtube-api-key
KICK_CLIENT_ID=your-kick-client-id
X_BEARER_TOKEN=your-x-bearer-token
