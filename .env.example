# Sovereignty AI Studio - Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════
# Backend FastAPI server port
BACKEND_PORT=8000

# Weather Dashboard (Quart) port
WEATHER_PORT=8001

# Node Bridge port (main entry point for frontend)
NODE_BRIDGE_PORT=9898

# Unified Server ports
PORT_UNIFIED=9000
PORT_BRIDGE=9898
PORT_AUTH=8443

# Frontend development server (React)
# Note: react-scripts defaults to 3000
FRONTEND_PORT=3000

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:password@localhost:5432/creativeflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=creativeflow_db

# ═══════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=Blake3
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here

# ═══════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:9898

# ═══════════════════════════════════════════════════════
# SERVICE URLS (for inter-service communication)
# ═══════════════════════════════════════════════════════
# In Docker environment, use service names:
# BACKEND_URL=http://backend:8000
# WEATHER_URL=http://backend:8001

# In local development, use localhost:
BACKEND_URL=http://localhost:8000
WEATHER_URL=http://localhost:8001

# ═══════════════════════════════════════════════════════
# PIPER TTS CONFIGURATION
# ═══════════════════════════════════════════════════════
PIPER_BIN=./piper
PIPER_MODEL=./models/en_US-lessac-medium.onnx
PIPER_DIR=./piper-tts

# ═══════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════
TLS_CERT=
TLS_KEY=

# ═══════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════
LOG_DIR=./logs
VERBOSE=0

# ═══════════════════════════════════════════════════════
# DEVELOPMENT/DEBUGGING
# ═══════════════════════════════════════════════════════
DEBUG=false

# ═══════════════════════════════════════════════════════
# PORT ALLOCATION SUMMARY
# ═══════════════════════════════════════════════════════
# 3000  - Frontend (React development server)
# 5432  - PostgreSQL Database
# 6379  - Redis Cache
# 8000  - Backend FastAPI
# 8001  - Weather Dashboard (Quart)
# 8443  - Unified Server Auth Proxy
# 9000  - Unified Server (Primary)
# 9898  - Node Bridge (Main entry point)
# ═══════════════════════════════════════════════════════
