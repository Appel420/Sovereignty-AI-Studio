# Sovereignty AI Studio - Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════
# DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# ALL EXTERNAL TRAFFIC GOES THROUGH PORT 9898
# This is your single entry point - the Dashboard
# All services connect to and are accessible through 9898

# ═══════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════
# Dashboard/Gateway port (ONLY external-facing port)
NODE_BRIDGE_PORT=9898

# Internal service ports (not exposed externally in Docker)
BACKEND_PORT=8000
WEATHER_PORT=8001
WEB_APP_PORT=8080
FRONTEND_PORT=3000

# Unified Server ports (for standalone mode)
PORT_UNIFIED=9000
PORT_BRIDGE=9898
PORT_AUTH=8443

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:password@localhost:5432/creativeflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=creativeflow_db

# ═══════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=Blake3
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here

# ═══════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:9898

# ═══════════════════════════════════════════════════════
# SERVICE URLS (for inter-service communication)
# ═══════════════════════════════════════════════════════
# In Docker environment, use service names (internal network):
# BACKEND_URL=http://backend:8000
# WEATHER_URL=http://backend:8001

# In local development, all services accessed through dashboard:
# Everything goes through port 9898
BACKEND_URL=http://localhost:9898/api/v1
WEATHER_URL=http://localhost:9898/api/weather

# For direct backend access in local dev (if needed)
# BACKEND_URL=http://localhost:8000
# WEATHER_URL=http://localhost:8001

# ═══════════════════════════════════════════════════════
# PIPER TTS CONFIGURATION
# ═══════════════════════════════════════════════════════
PIPER_BIN=./piper
PIPER_MODEL=./models/en_US-lessac-medium.onnx
PIPER_DIR=./piper-tts

# ═══════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════
TLS_CERT=
TLS_KEY=

# ═══════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════
LOG_DIR=./logs
VERBOSE=0

# ═══════════════════════════════════════════════════════
# DEVELOPMENT/DEBUGGING
# ═══════════════════════════════════════════════════════
DEBUG=false

# ═══════════════════════════════════════════════════════
# PORT ALLOCATION SUMMARY - DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# EXTERNAL ACCESS (What users/clients connect to):
# 9898  - Dashboard/Gateway (ONLY external port - all traffic)
#
# INTERNAL SERVICES (Docker network only):
# 3000  - Frontend (React development server)
# 5432  - PostgreSQL Database
# 6379  - Redis Cache
# 8000  - Backend FastAPI
# 8001  - Weather Dashboard (Quart)
# 8080  - Web App Server (apps/web/Server.js)
# 8443  - Unified Server Auth Proxy
# 9000  - Unified Server (Primary)
#
# KEY PRINCIPLE: Everything connects through 9898
# ═══════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════
# MULTI-AGENT SYSTEM CONFIGURATION
# ═══════════════════════════════════════════════════════
# Judge Agent
JUDGE_AGENT_PORT=9001
JUDGE_METRICS_PORT=8000

# AI Router Agent
AI_ROUTER_PORT=8001

# Plugin Agent
PLUGIN_AGENT_PORT=8002

# Platform Agent
PLATFORM_AGENT_PORT=8003

# Voice Assist Agent
VOICE_ASSIST_PORT=8004

# Gateway
GATEWAY_PORT=9898

# Prometheus metrics
METRICS_PORT=8000

# Platform connector credentials (streaming platforms)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
YOUTUBE_API_KEY=your-youtube-api-key
KICK_CLIENT_ID=your-kick-client-id
X_BEARER_TOKEN=your-x-bearer-token
