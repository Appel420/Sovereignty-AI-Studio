# Sovereignty AI Studio — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# ═══════════════════════════════════════════════════════
# DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# 9897 — Python bridge.py   (local AI/WS backend)
# 9898 — KODER frontend     (SGHv119.html static file server)
# 9899 — Node.js node-bridge (outgoing backend proxy, WS/API)
# Backend, DB, and Redis are internal-only (Docker network).

# ═══════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════
NODE_BRIDGE_PORT=9899
BACKEND_PORT=8002
WEATHER_PORT=8001
WEB_APP_PORT=8080
FRONTEND_PORT=3000
PORT_UNIFIED=9001
PORT_BRIDGE=9899
PORT_AUTH=8443

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://sovereignty:password@localhost:5432/sovereignty_db
POSTGRES_USER=sovereignty
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=sovereignty_db

# ═══════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════
JWT_SECRET=your-jwt-secret-here-change-in-production
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
KEY_FILE=.sg_master_key

# MASTER KEY — Required to keep JWT sessions alive across server restarts.
# Generate once with: npm run keygen
# Paste the MASTER_KEY_B64=... output below.
MASTER_KEY_B64=

# ═══════════════════════════════════════════════════════
# PERSISTENT MEMORY STORE (Node.js WebSocket sessions)
# ═══════════════════════════════════════════════════════
MEM_STORE_FILE=./data/memory/node_mem.json

# ═══════════════════════════════════════════════════════
# SOVEREIGN AI CONFIGURATION (no external SaaS)
# ═══════════════════════════════════════════════════════
SOVEREIGN_MODEL_PATH=/models/sovereign.gguf
SOVEREIGN_ONNX_PATH=/models/sovereign.onnx
SOVEREIGN_API_URL=http://localhost:9899/api/ai
SOVEREIGN_PROVIDER_ORDER=local_gguf,local_onnx,sovereign_api

# ═══════════════════════════════════════════════════════
# SERVICE URLs (inter-service communication)
# ═══════════════════════════════════════════════════════
BACKEND_URL=http://backend:8002
WEATHER_URL=http://backend:8001

# ═══════════════════════════════════════════════════════
# PIPER TTS CONFIGURATION (self-hosted voice)
# ═══════════════════════════════════════════════════════
PIPER_BIN=./piper
PIPER_MODEL=./models/en_US-lessac-medium.onnx
PIPER_DIR=./piper-tts
PIPER_MODEL_PATH=./models/en_US-lessac-medium.onnx

VOSK_MODEL_PATH=./models/vosk-model-small-en-us
VOICE_COLLAB_STATE_DIR=./data/voice-collaboration
VOICE_COLLAB_ALLOW_REMOTE_AGENT=0

# ═══════════════════════════════════════════════════════
# KEYCLOAK AUTHENTICATION (self-hosted)
# ═══════════════════════════════════════════════════════
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sovereignty
KEYCLOAK_CLIENT_ID=sovereignty-studio
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ═══════════════════════════════════════════════════════
# CORS / TLS / LOGGING
# ═══════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:9898
TLS_CERT=
TLS_KEY=
LOG_DIR=./logs
VERBOSE=0
DEBUG=false
ENVIRONMENT=production

# ═══════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════
# ALLOW_SHELL was REMOVED (issues #898 / #899). Shell exec is fail-closed.
# Do not reintroduce ALLOW_SHELL=1. See scripts/check_no_shell_bypass.sh.
SAVE_TRANSFERS=1
RELOAD=0

# ═══════════════════════════════════════════════════════
# MULTI-AGENT SYSTEM CONFIGURATION
# ═══════════════════════════════════════════════════════
JUDGE_AGENT_PORT=9003
JUDGE_METRICS_PORT=9002
AI_ROUTER_PORT=9004
PLUGIN_AGENT_PORT=9005
PLATFORM_AGENT_PORT=9006
VOICE_ASSIST_PORT=9007
GATEWAY_PORT=9001
SG_BRIDGE_URL=ws://localhost:9897
SG_PORT=9897
SG_HOST=localhost
GATEONE_VERIFIER_PORT=9899
GATEONE_VERIFIER_HOST=0.0.0.0
METRICS_PORT=9002

# ═══════════════════════════════════════════════════════
# PLATFORM CONNECTOR CREDENTIALS
# ═══════════════════════════════════════════════════════
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
YOUTUBE_API_KEY=your-youtube-api-key
KICK_CLIENT_ID=your-kick-client-id
X_BEARER_TOKEN=your-x-bearer-token
