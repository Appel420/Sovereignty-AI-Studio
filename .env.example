# Sovereignty AI Studio - Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════
# DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# ALL EXTERNAL TRAFFIC GOES THROUGH PORT 9898
# This is your single entry point - the Dashboard
# All services connect to and are accessible through 9898

# ═══════════════════════════════════════════════════════
# PORT CONFIGURATION
# ═══════════════════════════════════════════════════════
# Dashboard/Gateway port (ONLY external-facing port)
NODE_BRIDGE_PORT=9898

# Internal service ports (not exposed externally in Docker)
BACKEND_PORT=8000
WEATHER_PORT=8001
WEB_APP_PORT=8080
FRONTEND_PORT=3000

# Unified Server ports (for standalone mode)
PORT_UNIFIED=9000
PORT_BRIDGE=9898
PORT_AUTH=8443

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:password@localhost:5432/creativeflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=creativeflow_db

# ═══════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=Blake3
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here

# ═══════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:9898

# ═══════════════════════════════════════════════════════
# SERVICE URLS (for inter-service communication)
# ═══════════════════════════════════════════════════════
# In Docker environment, use service names (internal network):
# BACKEND_URL=http://backend:8000
# WEATHER_URL=http://backend:8001

# In local development, all services accessed through dashboard:
# Everything goes through port 9898
BACKEND_URL=http://localhost:9898/api/v1
WEATHER_URL=http://localhost:9898/api/weather

# For direct backend access in local dev (if needed)
# BACKEND_URL=http://localhost:8000
# WEATHER_URL=http://localhost:8001

# ═══════════════════════════════════════════════════════
# PIPER TTS CONFIGURATION
# ═══════════════════════════════════════════════════════
PIPER_BIN=./piper
PIPER_MODEL=./models/en_US-lessac-medium.onnx
PIPER_DIR=./piper-tts

# ═══════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════
TLS_CERT=
TLS_KEY=

# ═══════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════
LOG_DIR=./logs
VERBOSE=0

# ═══════════════════════════════════════════════════════
# DEVELOPMENT/DEBUGGING
# ═══════════════════════════════════════════════════════
DEBUG=false

# ═══════════════════════════════════════════════════════
# PORT ALLOCATION SUMMARY - DASHBOARD ARCHITECTURE
# ═══════════════════════════════════════════════════════
# EXTERNAL ACCESS (What users/clients connect to):
# 9898  - Dashboard/Gateway (ONLY external port - all traffic)
#
# INTERNAL SERVICES (Docker network only):
# 3000  - Frontend (React development server)
# 5432  - PostgreSQL Database
# 6379  - Redis Cache
# 8000  - Backend FastAPI
# 8001  - Weather Dashboard (Quart)
# 8080  - Web App Server (apps/web/Server.js)
# 8443  - Unified Server Auth Proxy
# 9000  - Unified Server (Primary)
#
# KEY PRINCIPLE: Everything connects through 9898
# ═══════════════════════════════════════════════════════
=======
# Sovereignty AI Studio - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# ============================================
# AI Agent API Keys
# ============================================

# Claude (Anthropic) API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GPT (OpenAI) API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Grok (xAI) API Key
# Get your key from: https://console.x.ai/
XAI_API_KEY=xai-your-key-here

# ============================================
# GitHub Integration (for Copilot)
# ============================================

# GitHub OAuth Application Credentials
# Create app at: https://github.com/settings/developers
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret

# ============================================
# Server Configuration
# ============================================

# Unified Server Port (default: 9000)
PORT_UNIFIED=9000

# Bridge Server Port (default: 9898)
PORT_BRIDGE=9898

# Authentication Server Port (default: 8443)
PORT_AUTH=8443

# Node Bridge Port (default: 9898)
NODE_BRIDGE_PORT=9898

# ============================================
# Backend Services
# ============================================

# FastAPI Backend URL (default: http://localhost:8000)
BACKEND_URL=http://localhost:8000

# Weather Service URL (default: http://localhost:8001)
WEATHER_URL=http://localhost:8001

# ============================================
# Database Configuration
# ============================================

# PostgreSQL Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://sovereignty:password@localhost:5432/sovereignty_db

# Redis Connection (for caching and sessions)
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# ============================================
# Security Configuration
# ============================================

# Secret key for JWT token signing (generate a random string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Master key file location (for encryption)
KEY_FILE=.sg_master_key

# ============================================
# Frontend Configuration
# ============================================

# React App API URL (should point to node-bridge)
REACT_APP_API_URL=http://localhost:9898/api/v1

# React App WebSocket URL
REACT_APP_WS_URL=ws://localhost:9898

# CORS Origin (for node-bridge)
CORS_ORIGIN=http://localhost:3000

# ============================================
# Logging & Monitoring
# ============================================

# Log directory for audit logs
LOG_DIR=./logs

# Enable verbose logging (1 = enabled, 0 = disabled)
VERBOSE=1

# ============================================
# Optional: Piper TTS Configuration
# ============================================

# Path to Piper executable
PIPER_BIN=./piper

# Path to Piper voice model
PIPER_MODEL=./en_US-lessac-medium.onnx

# Path to Piper config file
PIPER_CFG=./en_US-lessac-medium.onnx.json

# ============================================
# Optional: Advanced Features
# ============================================

# Allow shell command execution (1 = enabled, 0 = disabled)
# WARNING: Only enable if you understand the security implications
ALLOW_SHELL=0

# Save file transfers (1 = enabled, 0 = disabled)
SAVE_TRANSFERS=1

# ============================================
# Development Settings
# ============================================

# Flask/FastAPI environment
ENVIRONMENT=development

# Enable debug mode (not for production)
DEBUG=1

# Enable hot reload
RELOAD=1
