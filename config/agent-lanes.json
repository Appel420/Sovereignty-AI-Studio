{
  "version": "1.0.0",
  "repository": "Appel420/Sovereignty-AI-Studio",
  "protected_branches": ["main", "master", "Collaboration"],
  "agents": {
    "copilot": {"provider_path": "github-copilot", "branch_pattern": "copilot/*"},
    "gpt": {"provider_path": "openai-gpt", "branch_pattern": "gpt/*"},
    "grok": {"provider_path": "xai-grok", "branch_pattern": "grok/*"},
    "claude": {"provider_path": "anthropic-claude", "branch_pattern": "claude/*"},
    "ara": {"provider_path": "ara-core", "branch_pattern": "ara/*"},
    "devassist420": {"provider_path": "devassist420-local", "branch_pattern": "devassist420/*"}
  },
  "owner_approval_required_for": ["repo.patch", "repo.commit", "repo.push", "promotion"]
}
