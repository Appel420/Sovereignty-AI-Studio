Run this in /app/bubble.py — after the BPF attach:
import os, time, logging
logging.basicConfig(filename='/system/bubble/breath.bpf.log', level=logging.INFO, format=' %(message)s')

last = 0
while True:
    try:
        if os.path.exists("/proc/kprobe/sys_connect"):
            # peek bpf map or /proc/net/tcp — light read
            with open("/proc/net/tcp", "r") as f:
                for line in f:
                    parts = line.split()
                    if "00000000:0000" not in line: continue  # skip listening
                    if "ESTABLISHED" in line:
                        logging.info(f"OUTGOING | addr={parts[2]} | status=ALERT")
        time.sleep(3)
    except:
        pass
